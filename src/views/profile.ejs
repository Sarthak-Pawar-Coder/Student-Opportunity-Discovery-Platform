<%- include('partials/header') %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
  
  <!-- Profile Completion Bar Header Card -->
  <div class="bg-slate-900 p-6 sm:p-8 rounded-3xl border border-slate-800 shadow-xl space-y-4">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-white">Student Profile & Preferences</h1>
        <p class="text-sm text-slate-400 mt-0.5">Keep your skills and interests updated for accurate recommendation rankings</p>
      </div>
      <div class="text-right">
        <span class="text-3xl font-extrabold text-indigo-400"><%= user.completionPercentage %>%</span>
        <span class="text-xs text-slate-400 block font-medium">Profile Completeness</span>
      </div>
    </div>

    <!-- Progress Bar -->
    <div class="w-full bg-slate-800 rounded-full h-3 overflow-hidden">
      <div class="bg-gradient-to-r from-indigo-500 to-purple-600 h-3 rounded-full transition-all duration-500" style="width: <%= user.completionPercentage %>%;"></div>
    </div>

    <% if (welcome) { %>
      <div class="p-3.5 bg-indigo-950/80 border border-indigo-800 text-indigo-200 text-xs rounded-xl font-medium flex items-center space-x-2">
        <span>🎉 Welcome! Complete your skills and interests below to get instant opportunity rankings.</span>
      </div>
    <% } %>

    <% if (successMsg) { %>
      <div class="p-3.5 bg-emerald-950/80 border border-emerald-800 text-emerald-200 text-xs rounded-xl font-medium">
        <%= successMsg %>
      </div>
    <% } %>
  </div>

  <!-- Profile Form -->
  <form action="/profile" method="POST" class="bg-slate-900 p-6 sm:p-8 rounded-3xl border border-slate-800 shadow-xl space-y-8">
    
    <!-- Section 1: Academic Background -->
    <div>
      <h2 class="text-lg font-bold text-white mb-4 pb-2 border-b border-slate-800 flex items-center space-x-2">
        <span>🎓 Academic Background</span>
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="education_level" class="block text-sm font-semibold text-slate-300">Education Level</label>
          <select id="education_level" name="education_level" class="mt-1 block w-full px-4 py-3 rounded-xl border border-slate-700/80 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 text-slate-100 text-sm bg-slate-800">
            <option value="High School" <%= user.education_level === 'High School' ? 'selected' : '' %>>High School</option>
            <option value="Undergraduate" <%= user.education_level === 'Undergraduate' ? 'selected' : '' %>>Undergraduate</option>
            <option value="Master's" <%= user.education_level === "Master's" ? 'selected' : '' %>>Master's</option>
            <option value="PhD" <%= user.education_level === 'PhD' ? 'selected' : '' %>>PhD</option>
            <option value="Bootcamp / Self-Taught" <%= user.education_level === 'Bootcamp / Self-Taught' ? 'selected' : '' %>>Bootcamp / Self-Taught</option>
          </select>
        </div>

        <div>
          <label for="field_of_study" class="block text-sm font-semibold text-slate-300">Field of Study / Major</label>
          <input id="field_of_study" name="field_of_study" type="text" value="<%= user.field_of_study || '' %>" required class="mt-1 block w-full px-4 py-3 rounded-xl border border-slate-700/80 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 text-slate-100 text-sm bg-slate-800 placeholder-slate-500" placeholder="e.g. Computer Science, Electrical Engineering">
        </div>
      </div>
    </div>

    <!-- Section 2: Skills Tag Input -->
    <div>
      <h2 class="text-lg font-bold text-white mb-1 flex items-center space-x-2">
        <span>💻 Your Technical & Soft Skills</span>
      </h2>
      <p class="text-xs text-slate-400 mb-3">Comma-separated list of skills you possess (+3 points per match in recommendation algorithm)</p>

      <input id="skills" name="skills" type="text" value="<%= (user.skills || []).join(', ') %>" class="block w-full px-4 py-3 rounded-xl border border-slate-700/80 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 text-slate-100 text-sm bg-slate-800 placeholder-slate-500" placeholder="e.g. Python, React, Node.js, SQL, Docker, Machine Learning">

      <!-- Current Skills Tags Display -->
      <div class="mt-3 flex flex-wrap gap-2">
        <% (user.skills || []).forEach(skill => { %>
          <span class="inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-bold bg-indigo-950/80 text-indigo-300 border border-indigo-800/80 transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer hover:shadow-sm">
            <%= skill %>
          </span>
        <% }) %>
      </div>

      <!-- Quick Add Recommended Skills from Skill Gap Advisor -->
      <% if (typeof skillGapAnalysis !== 'undefined' && skillGapAnalysis && skillGapAnalysis.recommendations && skillGapAnalysis.recommendations.length > 0) { %>
        <div class="mt-4 p-4 bg-purple-950/40 border border-purple-800/60 rounded-2xl space-y-2.5">
          <div class="flex items-center justify-between">
            <span class="text-xs font-extrabold text-amber-300 uppercase tracking-wider flex items-center space-x-1.5">
              <span>🧠 Recommended Skills to Unlock Opportunities</span>
            </span>
            <span class="text-[11px] text-slate-400">Click to append to your skills</span>
          </div>
          <div class="flex flex-wrap gap-2">
            <% skillGapAnalysis.recommendations.forEach(gap => { %>
              <button type="button" onclick="addSkillToInput('<%= gap.skill %>')" class="px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-800 hover:bg-purple-900/80 text-purple-200 border border-purple-700/60 transition-all duration-200 hover:scale-105 active:scale-95 flex items-center space-x-1.5 shadow-sm focus:outline-none" title="Click to add <%= gap.skill %> to input">
                <span>+ <%= gap.skill %></span>
                <span class="px-1.5 py-0.2 rounded-md bg-emerald-950 text-emerald-300 text-[10px] font-bold">+<%= gap.unlockedCount %> Opps</span>
              </button>
            <% }) %>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Section 3: Interests & Preferred Tags -->
    <div>
      <h2 class="text-lg font-bold text-white mb-1 flex items-center space-x-2">
        <span>💡 Areas of Interest & Tags</span>
      </h2>
      <p class="text-xs text-slate-400 mb-3">Comma-separated list of topics you are passionate about (+2 points per match)</p>

      <input id="interests" name="interests" type="text" value="<%= (user.interests || []).join(', ') %>" class="block w-full px-4 py-3 rounded-xl border border-slate-700/80 focus:outline-none focus:ring-2 focus:ring-indigo-500/40 text-slate-100 text-sm bg-slate-800 placeholder-slate-500" placeholder="e.g. Artificial Intelligence, Web Development, Cloud Computing, Healthcare">

      <!-- Current Interest Tags -->
      <div class="mt-3 flex flex-wrap gap-2">
        <% (user.interests || []).forEach(interest => { %>
          <span class="inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-bold bg-purple-950/80 text-purple-300 border border-purple-800/80 transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer hover:shadow-sm">
            <%= interest %>
          </span>
        <% }) %>
      </div>
    </div>

    <!-- Section 4: Preferred Categories -->
    <div>
      <h2 class="text-lg font-bold text-white mb-3 flex items-center space-x-2">
        <span>📌 Preferred Opportunity Categories</span>
      </h2>
      
      <% const categories = [
        { id: 'hackathon', name: 'Hackathon', badge: 'badge-hackathon' },
        { id: 'internship', name: 'Internship', badge: 'badge-internship' },
        { id: 'scholarship', name: 'Scholarship', badge: 'badge-scholarship' },
        { id: 'certification', name: 'Certification', badge: 'badge-certification' },
        { id: 'competition', name: 'Competition', badge: 'badge-competition' },
        { id: 'workshop', name: 'Workshop', badge: 'badge-workshop' },
        { id: 'course', name: 'Course', badge: 'badge-course' }
      ]; %>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <% categories.forEach(cat => { %>
          <label class="flex items-center space-x-2.5 p-3 rounded-2xl border border-slate-800 hover:bg-slate-800/60 cursor-pointer transition-colors">
            <input type="checkbox" name="preferred_categories" value="<%= cat.id %>" <%= (user.preferred_categories || []).includes(cat.id) ? 'checked' : '' %> class="w-4 h-4 text-indigo-600 bg-slate-800 border-slate-700 rounded focus:ring-indigo-500/40">
            <span class="text-xs font-bold <%= cat.badge %> px-2.5 py-0.5 rounded-full"><%= cat.name %></span>
          </label>
        <% }) %>
      </div>
    </div>

    <!-- Submit Button with Button Hover -->
    <div class="pt-4 border-t border-slate-800 flex justify-end">
      <button type="submit" class="px-8 py-3.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm rounded-xl shadow-lg shadow-indigo-600/30 transition-all duration-200 hover:scale-[1.02] active:scale-95 focus:outline-none focus:ring-2 focus:ring-indigo-500/40">
        Save Profile & Update Recommendations
      </button>
    </div>

  </form>
</div>

<script>
function addSkillToInput(skillName) {
  const input = document.getElementById('skills');
  if (!input) return;
  const current = input.value.split(',').map(s => s.trim()).filter(Boolean);
  if (!current.some(s => s.toLowerCase() === skillName.toLowerCase())) {
    current.push(skillName);
    input.value = current.join(', ');
    input.focus();
  }
}
</script>

<%- include('partials/footer') %>
