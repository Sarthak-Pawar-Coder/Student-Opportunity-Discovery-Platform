<%- include('partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
  
  <!-- Header Hero Card: Greet logged-in user -->
  <div class="bg-gradient-to-r from-indigo-900/90 via-indigo-950 to-slate-900 rounded-3xl p-6 sm:p-8 text-white shadow-2xl shadow-indigo-950/50 relative overflow-hidden flex flex-col md:flex-row items-start md:items-center justify-between gap-6 border border-indigo-500/30">
    <div class="space-y-2 relative z-10">
      <div class="inline-flex items-center space-x-2 px-3.5 py-1 rounded-full bg-indigo-500/20 backdrop-blur-md text-indigo-300 text-xs font-bold border border-indigo-500/30">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span>Welcome Back, <%= user.name %>!</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Student Dashboard</h1>
      <p class="text-slate-300 text-sm max-w-2xl leading-relaxed">
        Your personalized opportunity engine has matched and ranked listings according to your background in <strong class="text-white font-bold"><%= user.field_of_study || 'Computer Science' %></strong>.
      </p>
    </div>

    <!-- Profile Progress Box -->
    <div class="bg-slate-900/80 backdrop-blur-md p-5 rounded-2xl border border-indigo-500/30 text-center min-w-[210px] w-full md:w-auto relative z-10 shadow-lg">
      <div class="text-3xl font-black text-indigo-400"><%= user.completionPercentage %>%</div>
      <div class="text-xs text-slate-300 font-semibold mt-0.5">Profile Completeness</div>
      <div class="w-full bg-slate-800 rounded-full h-2 mt-2 overflow-hidden">
        <div class="bg-gradient-to-r from-amber-400 to-amber-300 h-2 rounded-full transition-all duration-500" style="width: <%= user.completionPercentage %>%;"></div>
      </div>
      <a href="/profile" class="text-xs text-amber-300 hover:text-white underline mt-2.5 block font-bold transition-all duration-200 hover:scale-[1.02] focus:outline-none">
        Edit Profile & Skills &rarr;
      </a>
    </div>

    <!-- Decorative ambient glow -->
    <div class="absolute -right-12 -bottom-12 w-64 h-64 bg-purple-600/15 rounded-full blur-3xl pointer-events-none"></div>
  </div>

  <% if (addedSkill) { %>
    <div class="p-4 bg-emerald-950/60 border border-emerald-800 text-emerald-200 text-sm rounded-2xl flex items-center justify-between shadow-md">
      <div class="flex items-center space-x-2">
        <span class="text-lg">✅</span>
        <span>Successfully added <strong>"<%= addedSkill %>"</strong> to your profile skills! Your opportunity recommendations have been recalculated.</span>
      </div>
      <a href="/dashboard" class="text-xs font-bold text-emerald-400 hover:underline focus:outline-none">Dismiss</a>
    </div>
  <% } %>

  <!-- Metric Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    
    <!-- Stat 1: Saved Bookmarks -->
    <div class="group bg-slate-900 p-6 rounded-2xl border border-slate-800 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-indigo-500/60 flex items-center justify-between cursor-pointer">
      <div>
        <span class="text-xs font-bold uppercase text-slate-400 tracking-wider">Saved Bookmarks</span>
        <div class="text-3xl font-extrabold text-white mt-1"><%= totalBookmarks %></div>
        <a href="/bookmarks" class="text-xs font-bold text-indigo-400 hover:underline mt-1.5 block">View saved list &rarr;</a>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-indigo-950/80 text-indigo-400 flex items-center justify-center font-bold text-xl transition-transform duration-300 group-hover:scale-110 border border-indigo-800/80">
        ⭐
      </div>
    </div>

    <!-- Stat 2: Closing Soon -->
    <div class="group bg-slate-900 p-6 rounded-2xl border border-slate-800 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-rose-500/60 flex items-center justify-between cursor-pointer">
      <div>
        <span class="text-xs font-bold uppercase text-slate-400 tracking-wider">Closing Soon</span>
        <div class="text-3xl font-extrabold text-rose-400 mt-1"><%= closingSoonCount %></div>
        <span class="text-xs text-slate-400 font-medium mt-1 block">Deadlines ≤ 7 days</span>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-rose-950/80 text-rose-400 flex items-center justify-center font-bold text-xl transition-transform duration-300 group-hover:scale-110 border border-rose-800/80">
        ⏰
      </div>
    </div>

    <!-- Stat 3: Top Match Score -->
    <div class="group bg-slate-900 p-6 rounded-2xl border border-slate-800 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-purple-500/60 flex items-center justify-between cursor-pointer">
      <div>
        <span class="text-xs font-bold uppercase text-slate-400 tracking-wider">Top Match Score</span>
        <div class="text-3xl font-extrabold text-purple-400 mt-1">
          <%= topRecommendations.length > 0 ? topRecommendations[0].matchScore : 0 %> pts
        </div>
        <span class="text-xs text-slate-400 font-medium mt-1 block">Best fit match rating</span>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-purple-950/80 text-purple-400 flex items-center justify-center font-bold text-xl transition-transform duration-300 group-hover:scale-110 border border-purple-800/80">
        🎯
      </div>
    </div>

    <!-- Stat 4: Swipe Discovery Deck -->
    <div class="group bg-slate-900 p-6 rounded-2xl border border-slate-800 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:border-emerald-500/60 flex items-center justify-between cursor-pointer">
      <div>
        <span class="text-xs font-bold uppercase text-slate-400 tracking-wider">Swipe Discovery</span>
        <div class="text-lg font-extrabold text-white mt-1">Interactive Deck</div>
        <a href="/discover" class="text-xs font-bold text-emerald-400 hover:underline mt-1.5 block">Launch Swipe View &rarr;</a>
      </div>
      <div class="w-12 h-12 rounded-2xl bg-emerald-950/80 text-emerald-400 flex items-center justify-center font-bold text-xl transition-transform duration-300 group-hover:scale-110 border border-emerald-800/80">
        ⚡
      </div>
    </div>

  </div>

  <!-- ⭐ WOW FEATURE — Skill Gap Advisor Banner Card -->
  <% if (skillGapAnalysis) { %>
    <div id="skill-gap-banner" class="bg-gradient-to-r from-indigo-900 via-purple-900 to-slate-900 text-white rounded-3xl shadow-2xl shadow-indigo-950/50 relative overflow-hidden border border-indigo-500/40 p-6 sm:p-8 transition-all duration-300">
      
      <!-- Decorative glow -->
      <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-purple-500/20 rounded-full blur-2xl pointer-events-none"></div>

      <!-- Header row with Dismiss Button -->
      <div class="flex items-center justify-between mb-3 relative z-10">
        <div class="flex items-center space-x-2 text-xs font-extrabold text-amber-300 uppercase tracking-widest">
          <span class="px-3 py-1 rounded-full bg-amber-400/20 border border-amber-300/40">Skill Gap Advisor</span>
          <span>&bull;</span>
          <span>Actionable Career Guidance</span>
        </div>

        <button type="button" id="dismiss-advisor-btn" class="p-1.5 text-slate-400 hover:text-white rounded-lg hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-amber-400/40" title="Dismiss Skill Gap Advisor">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 relative z-10">
        <div class="space-y-3 max-w-3xl">
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight">
            Add <span class="text-amber-300 font-black underline decoration-amber-400 decoration-wavy underline-offset-4">"<%= skillGapAnalysis.topSkill %>"</span> to your profile to unlock <%= skillGapAnalysis.unlockedCount %> more matching opportunities!
          </h2>
          <p class="text-slate-300 text-sm leading-relaxed">
            Our recommendation engine analyzed active listings against your profile and discovered that acquiring <strong><%= skillGapAnalysis.topSkill %></strong> yields the single highest opportunity gain across:
            <span class="text-white font-semibold"><%= skillGapAnalysis.sampleOpportunities.join(', ') %></span>.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-3 w-full lg:w-auto shrink-0">
          <form action="/profile/add-skill" method="POST" class="add-skill-ajax-form w-full sm:w-auto" data-skill="<%= skillGapAnalysis.topSkill %>">
            <input type="hidden" name="skill" value="<%= skillGapAnalysis.topSkill %>">
            <button type="submit" class="add-skill-btn bg-amber-400 hover:bg-amber-300 text-slate-950 font-extrabold px-6 py-3 rounded-xl shadow-lg hover:shadow-amber-400/30 transition-all duration-200 hover:scale-105 active:scale-95 flex items-center justify-center space-x-2 w-full sm:w-auto focus:outline-none">
              <span>+ Add "<%= skillGapAnalysis.topSkill %>" to Profile</span>
            </button>
          </form>
          <button type="button" id="btn-open-gaps-modal" class="w-full sm:w-auto px-6 py-3 bg-slate-800/80 hover:bg-slate-700 text-white font-bold text-sm rounded-xl border border-slate-700 transition-all duration-200 hover:scale-[1.02] active:scale-95 text-center focus:outline-none flex items-center justify-center space-x-1.5">
            <span>View All Gaps (<%= (skillGapAnalysis.recommendations || []).length %>)</span>
            <span>&rarr;</span>
          </button>
        </div>
      </div>
    </div>

    <!-- ⭐ Dedicated Interactive Modal: All Identified Skill Gaps -->
    <div id="skill-gaps-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md">
      <div class="bg-slate-900 border border-slate-700 rounded-3xl max-w-3xl w-full max-h-[90vh] overflow-y-auto shadow-2xl flex flex-col p-6 sm:p-8 space-y-6 relative">
        
        <!-- Modal Header -->
        <div class="flex items-start justify-between border-b border-slate-800 pb-4">
          <div class="space-y-1">
            <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-purple-950/80 text-purple-300 text-xs font-extrabold border border-purple-800">
              <span>🧠 Skill Gap Intelligence</span>
            </div>
            <h2 class="text-2xl font-black text-white">Top Recommended Skills to Unlock Opportunities</h2>
            <p class="text-xs text-slate-400">These skills are missing from your profile but are actively required by the highest volume of live opportunities.</p>
          </div>
          <button type="button" id="btn-close-gaps-modal" class="p-2 text-slate-400 hover:text-white rounded-xl hover:bg-slate-800 transition-colors focus:outline-none" title="Close Modal">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <!-- Skill Cards Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% (skillGapAnalysis.recommendations || []).forEach(gap => { %>
            <div class="bg-slate-950/70 border border-slate-800 rounded-2xl p-4 flex flex-col justify-between space-y-3 hover:border-indigo-500/50 transition-colors">
              <div>
                <div class="flex items-center justify-between">
                  <span class="text-base font-extrabold text-amber-300"><%= gap.skill %></span>
                  <span class="px-2.5 py-0.5 rounded-full bg-emerald-950/80 border border-emerald-800 text-emerald-300 font-bold text-xs">
                    +<%= gap.unlockedCount %> Opps
                  </span>
                </div>
                <p class="text-xs text-slate-400 mt-2 leading-relaxed">
                  Required by: <strong class="text-slate-200"><%= (gap.sampleOpportunities || []).slice(0, 2).join(', ') %></strong>
                </p>
              </div>

              <form action="/profile/add-skill" method="POST" class="add-skill-ajax-form pt-2" data-skill="<%= gap.skill %>">
                <input type="hidden" name="skill" value="<%= gap.skill %>">
                <button type="submit" class="add-skill-btn w-full py-2 px-3 bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs rounded-xl shadow-md transition-all duration-200 hover:scale-[1.02] active:scale-95 flex items-center justify-center space-x-1.5 focus:outline-none">
                  <span>+ Add "<%= gap.skill %>" to Profile</span>
                </button>
              </form>
            </div>
          <% }) %>
        </div>

        <!-- Modal Footer -->
        <div class="flex items-center justify-between pt-4 border-t border-slate-800 text-xs">
          <span class="text-slate-400">Click any skill to instantly add it to your profile and recalculate match scores.</span>
          <button type="button" id="btn-close-gaps-modal-footer" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold rounded-xl transition-all">
            Done
          </button>
        </div>

      </div>
    </div>
  <% } %>

  <!-- Category Breakdown Multi-segment Bar Chart -->
  <div class="bg-slate-900 p-6 sm:p-8 rounded-3xl border border-slate-800 shadow-lg space-y-5 transition-colors duration-200">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-xl font-bold text-white">Active Opportunities Category Breakdown</h2>
        <p class="text-xs text-slate-400 mt-0.5">Distribution across Hackathons, Internships, Scholarships, Certifications, Competitions, Workshops, and Courses</p>
      </div>
      <span class="text-xs font-bold text-indigo-300 bg-indigo-950/80 px-3 py-1 rounded-full border border-indigo-800/80">Visual Insights</span>
    </div>

    <!-- Multi-segment Horizontal Bar -->
    <div class="chart-bar-container bg-slate-800 shadow-inner">
      
      <!-- Hackathon Segment -->
      <% if (categoryPercentages.hackathon > 0) { %>
        <div class="chart-segment-wrapper" style="width: <%= categoryPercentages.hackathon %>%;">
          <div class="chart-segment bg-purple-500 transition-all duration-500" title="Hackathons: <%= categoryCounts.hackathon %> (<%= categoryPercentages.hackathon %>%)"></div>
          <div class="chart-tooltip bg-slate-950 text-white text-[11px] font-bold px-2.5 py-1 rounded-md shadow-md border border-slate-700">
            Hackathons: <%= categoryCounts.hackathon %> (<%= categoryPercentages.hackathon %>%)
          </div>
        </div>
      <% } %>

      <!-- Internship Segment -->
      <% if (categoryPercentages.internship > 0) { %>
        <div class="chart-segment-wrapper" style="width: <%= categoryPercentages.internship %>%;">
          <div class="chart-segment bg-blue-500 transition-all duration-500" title="Internships: <%= categoryCounts.internship %> (<%= categoryPercentages.internship %>%)"></div>
          <div class="chart-tooltip bg-slate-950 text-white text-[11px] font-bold px-2.5 py-1 rounded-md shadow-md border border-slate-700">
            Internships: <%= categoryCounts.internship %> (<%= categoryPercentages.internship %>%)
          </div>
        </div>
      <% } %>

      <!-- Scholarship Segment -->
      <% if (categoryPercentages.scholarship > 0) { %>
        <div class="chart-segment-wrapper" style="width: <%= categoryPercentages.scholarship %>%;">
          <div class="chart-segment bg-emerald-500 transition-all duration-500" title="Scholarships: <%= categoryCounts.scholarship %> (<%= categoryPercentages.scholarship %>%)"></div>
          <div class="chart-tooltip bg-slate-950 text-white text-[11px] font-bold px-2.5 py-1 rounded-md shadow-md border border-slate-700">
            Scholarships: <%= categoryCounts.scholarship %> (<%= categoryPercentages.scholarship %>%)
          </div>
        </div>
      <% } %>

      <!-- Certification Segment -->
      <% if (categoryPercentages.certification > 0) { %>
        <div class="chart-segment-wrapper" style="width: <%= categoryPercentages.certification %>%;">
          <div class="chart-segment bg-amber-500 transition-all duration-500" title="Certifications: <%= categoryCounts.certification %> (<%= categoryPercentages.certification %>%)"></div>
          <div class="chart-tooltip bg-slate-950 text-white text-[11px] font-bold px-2.5 py-1 rounded-md shadow-md border border-slate-700">
            Certifications: <%= categoryCounts.certification %> (<%= categoryPercentages.certification %>%)
          </div>
        </div>
      <% } %>

      <!-- Competition Segment -->
      <% if (categoryPercentages.competition > 0) { %>
        <div class="chart-segment-wrapper" style="width: <%= categoryPercentages.competition %>%;">
          <div class="chart-segment bg-rose-500 transition-all duration-500" title="Competitions: <%= categoryCounts.competition %> (<%= categoryPercentages.competition %>%)"></div>
          <div class="chart-tooltip bg-slate-950 text-white text-[11px] font-bold px-2.5 py-1 rounded-md shadow-md border border-slate-700">
            Competitions: <%= categoryCounts.competition %> (<%= categoryPercentages.competition %>%)
          </div>
        </div>
      <% } %>

      <!-- Workshop Segment -->
      <% if (categoryPercentages.workshop > 0) { %>
        <div class="chart-segment-wrapper" style="width: <%= categoryPercentages.workshop %>%;">
          <div class="chart-segment bg-teal-500 transition-all duration-500" title="Workshops: <%= categoryCounts.workshop %> (<%= categoryPercentages.workshop %>%)"></div>
          <div class="chart-tooltip bg-slate-950 text-white text-[11px] font-bold px-2.5 py-1 rounded-md shadow-md border border-slate-700">
            Workshops: <%= categoryCounts.workshop %> (<%= categoryPercentages.workshop %>%)
          </div>
        </div>
      <% } %>

      <!-- Course Segment -->
      <% if (categoryPercentages.course > 0) { %>
        <div class="chart-segment-wrapper" style="width: <%= categoryPercentages.course %>%;">
          <div class="chart-segment bg-cyan-500 transition-all duration-500" title="Courses: <%= categoryCounts.course %> (<%= categoryPercentages.course %>%)"></div>
          <div class="chart-tooltip bg-slate-950 text-white text-[11px] font-bold px-2.5 py-1 rounded-md shadow-md border border-slate-700">
            Courses: <%= categoryCounts.course %> (<%= categoryPercentages.course %>%)
          </div>
        </div>
      <% } %>

    </div>

    <!-- Chart Legend -->
    <div class="flex flex-wrap items-center gap-4 pt-2 text-xs">
      <span class="flex items-center space-x-1.5 font-semibold text-slate-300">
        <span class="w-3 h-3 rounded-full bg-purple-500 shadow-xs"></span>
        <span>Hackathon (<%= categoryCounts.hackathon %>)</span>
      </span>
      <span class="flex items-center space-x-1.5 font-semibold text-slate-300">
        <span class="w-3 h-3 rounded-full bg-blue-500 shadow-xs"></span>
        <span>Internship (<%= categoryCounts.internship %>)</span>
      </span>
      <span class="flex items-center space-x-1.5 font-semibold text-slate-300">
        <span class="w-3 h-3 rounded-full bg-emerald-500 shadow-xs"></span>
        <span>Scholarship (<%= categoryCounts.scholarship %>)</span>
      </span>
      <span class="flex items-center space-x-1.5 font-semibold text-slate-300">
        <span class="w-3 h-3 rounded-full bg-amber-500 shadow-xs"></span>
        <span>Certification (<%= categoryCounts.certification %>)</span>
      </span>
      <span class="flex items-center space-x-1.5 font-semibold text-slate-300">
        <span class="w-3 h-3 rounded-full bg-rose-500 shadow-xs"></span>
        <span>Competition (<%= categoryCounts.competition %>)</span>
      </span>
      <span class="flex items-center space-x-1.5 font-semibold text-slate-300">
        <span class="w-3 h-3 rounded-full bg-teal-500 shadow-xs"></span>
        <span>Workshop (<%= categoryCounts.workshop %>)</span>
      </span>
      <span class="flex items-center space-x-1.5 font-semibold text-slate-300">
        <span class="w-3 h-3 rounded-full bg-cyan-500 shadow-xs"></span>
        <span>Course (<%= categoryCounts.course %>)</span>
      </span>
    </div>
  </div>

  <!-- Top Explainable Recommendation Cards -->
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2">
      <div>
        <h2 class="text-2xl font-bold text-white">Recommended For You (Top Matches)</h2>
        <p class="text-xs text-slate-400">Ranked transparently by matching skills, interests, education eligibility & deadline urgency</p>
      </div>
      <a href="/opportunities" class="text-sm font-bold text-indigo-400 hover:text-indigo-300 transition-colors focus:outline-none">
        View All Opportunities &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% topRecommendations.forEach(opp => { %>
        <% const isBookmarked = userBookmarkIds.has(opp.id); %>
        
        <div class="bg-slate-900 rounded-2xl border border-slate-800 shadow-lg transition-all duration-300 ease-out hover:-translate-y-1.5 hover:shadow-2xl hover:shadow-indigo-500/10 hover:border-indigo-500/60 flex flex-col justify-between overflow-hidden group">
          
          <div class="p-6 space-y-4">
            
            <!-- Category Badge + Score Pill -->
            <div class="flex items-center justify-between">
              <% let badgeClass = 'badge-internship';
                 if (opp.category === 'hackathon') badgeClass = 'badge-hackathon';
                 else if (opp.category === 'scholarship') badgeClass = 'badge-scholarship';
                 else if (opp.category === 'certification') badgeClass = 'badge-certification';
                 else if (opp.category === 'competition') badgeClass = 'badge-competition';
                 else if (opp.category === 'workshop') badgeClass = 'badge-workshop';
                 else if (opp.category === 'course') badgeClass = 'badge-course';
              %>
              <span class="<%= badgeClass %> px-3 py-1 rounded-full text-xs font-bold capitalize">
                <%= opp.category %>
              </span>

              <!-- Match Score Badge -->
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-indigo-950/90 text-indigo-300 border border-indigo-800/80" title="Explainable match score">
                🎯 Match: <%= opp.matchScore %> pts
              </span>
            </div>

            <!-- Title & Org -->
            <div>
              <h3 class="font-bold text-lg text-white group-hover:text-indigo-400 transition-colors line-clamp-2">
                <a href="/opportunities/<%= opp.id %>" class="focus:outline-none rounded-sm"><%= opp.title %></a>
              </h3>
              <p class="text-xs font-semibold text-slate-400 mt-1"><%= opp.organization %> &bull; <%= opp.location %></p>
            </div>

            <!-- EXPLAINABLE "WHY RECOMMENDED" CHIP BOX -->
            <% if (opp.matchDetails && opp.matchDetails.reasons.length > 0) { %>
              <div class="p-3.5 bg-slate-800/60 rounded-xl border border-slate-700/60 text-xs space-y-1">
                <span class="font-bold text-indigo-300 block text-[11px] uppercase tracking-wider">Why Recommended:</span>
                <% opp.matchDetails.reasons.forEach(reason => { %>
                  <div class="flex items-center space-x-1.5 text-slate-300">
                    <span class="text-indigo-400 text-xs font-bold">&bull;</span>
                    <span><%= reason %></span>
                  </div>
                <% }) %>
              </div>
            <% } %>

            <!-- Required Skills Tags -->
            <div class="flex flex-wrap gap-1.5">
              <% (opp.required_skills || []).forEach(skill => { %>
                <% const isUserSkill = (user.skills || []).map(s => s.toLowerCase()).includes(skill.toLowerCase()); %>
                <% if (isUserSkill) { %>
                  <span class="px-2.5 py-1 rounded-lg text-xs font-bold bg-indigo-600 text-white border-2 border-indigo-500 shadow-sm transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer flex items-center space-x-1">
                    <span>✓</span>
                    <span><%= skill %></span>
                  </span>
                <% } else { %>
                  <span class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-800 text-slate-300 border border-slate-700 transition-all duration-200 hover:scale-105 active:scale-95 cursor-pointer hover:shadow-sm">
                    <%= skill %>
                  </span>
                <% } %>
              <% }) %>
            </div>

          </div>

          <!-- Card Footer -->
          <div class="px-6 py-4 bg-slate-950/60 border-t border-slate-800/80 flex items-center justify-between text-xs">
            <span class="font-semibold text-slate-400">
              ⏰ Deadline: <%= opp.deadline %>
            </span>

            <div class="flex items-center space-x-2">
              <!-- Bookmark Button -->
              <button data-opportunity-id="<%= opp.id %>" class="bookmark-toggle-btn px-3.5 py-1.5 rounded-xl font-bold flex items-center space-x-1.5 transition-all duration-200 hover:scale-[1.02] active:scale-95 hover:shadow-md focus:outline-none <%= isBookmarked ? 'bg-indigo-600 text-white' : 'bg-slate-800 text-slate-300 hover:bg-slate-700' %>">
                <svg class="w-4 h-4 bookmark-icon transition-transform duration-300 active:scale-125" fill="<%= isBookmarked ? 'currentColor' : 'none' %>" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                </svg>
                <span class="bookmark-text"><%= isBookmarked ? 'Saved' : 'Save' %></span>
              </button>

              <a href="/opportunities/<%= opp.id %>" class="px-3.5 py-1.5 bg-slate-800 border border-slate-700 hover:bg-slate-700 text-slate-200 font-bold rounded-xl transition-all duration-200 hover:scale-[1.02] active:scale-95 hover:shadow-md focus:outline-none">
                Details
              </a>
            </div>
          </div>

        </div>
      <% }) %>
    </div>
  </div>

</div>

<!-- Client script for Skill Gap Advisor dismissal, modal & AJAX addition -->
<script>
document.addEventListener('DOMContentLoaded', () => {
  const banner = document.getElementById('skill-gap-banner');
  const dismissBtn = document.getElementById('dismiss-advisor-btn');
  const modal = document.getElementById('skill-gaps-modal');
  const openModalBtn = document.getElementById('btn-open-gaps-modal');
  const closeModalBtn = document.getElementById('btn-close-gaps-modal');
  const closeModalFooterBtn = document.getElementById('btn-close-gaps-modal-footer');

  // 1. Session-based dismissal of Skill Gap Advisor banner
  if (banner) {
    if (sessionStorage.getItem('dismissSkillGapAdvisor') === 'true') {
      banner.style.display = 'none';
    }

    if (dismissBtn) {
      dismissBtn.addEventListener('click', () => {
        banner.style.opacity = '0';
        banner.style.transform = 'scale(0.98)';
        setTimeout(() => {
          banner.style.display = 'none';
          sessionStorage.setItem('dismissSkillGapAdvisor', 'true');
        }, 200);
      });
    }
  }

  // 2. Interactive Modal Controls
  function openModal() {
    if (!modal) return;
    modal.classList.remove('hidden');
    document.body.classList.add('overflow-hidden');
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    document.body.classList.remove('overflow-hidden');
  }

  if (openModalBtn) openModalBtn.addEventListener('click', openModal);
  if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
  if (closeModalFooterBtn) closeModalFooterBtn.addEventListener('click', closeModal);

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeModal();
    });
  }

  // 3. Smooth AJAX Skill Addition
  document.querySelectorAll('.add-skill-ajax-form').forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('.add-skill-btn') || form.querySelector('button[type="submit"]');
      const skillInput = form.querySelector('input[name="skill"]');
      const skillName = (skillInput ? skillInput.value : form.dataset.skill || '').trim();
      if (!skillName) return;

      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span>Adding...</span>';
      }

      try {
        const res = await fetch('/profile/add-skill', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded',
            'Accept': 'application/json'
          },
          body: new URLSearchParams({ skill: skillName })
        });

        const data = await res.json();
        if (data.success) {
          if (btn) {
            btn.classList.remove('bg-amber-400', 'hover:bg-amber-300', 'bg-indigo-600', 'hover:bg-indigo-500', 'text-slate-950');
            btn.classList.add('bg-emerald-600', 'text-white', 'cursor-default');
            btn.innerHTML = '<span>✓ Added to Profile</span>';
          }

          // Update any other buttons for the same skill in modal/banner
          document.querySelectorAll(`.add-skill-ajax-form[data-skill="${skillName}"] .add-skill-btn`).forEach(otherBtn => {
            otherBtn.disabled = true;
            otherBtn.classList.remove('bg-amber-400', 'hover:bg-amber-300', 'bg-indigo-600', 'hover:bg-indigo-500', 'text-slate-950');
            otherBtn.classList.add('bg-emerald-600', 'text-white', 'cursor-default');
            otherBtn.innerHTML = '<span>✓ Added</span>';
          });

          // Smoothly update profile completion percentages if returned
          if (data.completionPercentage) {
            document.querySelectorAll('.profile-completion-pct').forEach(el => {
              el.textContent = `${data.completionPercentage}%`;
            });
          }

          // Show quick toast notification
          showToast(`Successfully added "${skillName}"! Recalculating...`, 'success');

          // If added from main banner, hide banner smoothly after a moment so it doesn't repeatedly prompt
          if (form.closest('#skill-gap-banner')) {
            setTimeout(() => {
              banner.style.opacity = '0';
              banner.style.transform = 'scale(0.98)';
              setTimeout(() => {
                banner.style.display = 'none';
                sessionStorage.setItem('dismissSkillGapAdvisor', 'true');
              }, 250);
            }, 900);
          }
        }
      } catch (err) {
        console.error('Failed to add skill via AJAX:', err);
        form.submit(); // fallback to normal form submit
      }
    });
  });

  function showToast(msg, type = 'info') {
    let toast = document.getElementById('dynamic-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'dynamic-toast';
      toast.className = 'fixed bottom-6 left-1/2 transform -translate-x-1/2 px-5 py-3 rounded-2xl text-white font-bold text-sm shadow-2xl transition-all duration-300 z-50 pointer-events-none opacity-0';
      document.body.appendChild(toast);
    }
    toast.textContent = msg;
    toast.className = `fixed bottom-6 left-1/2 transform -translate-x-1/2 px-5 py-3 rounded-2xl text-white font-bold text-sm shadow-2xl transition-all duration-300 z-50 pointer-events-none ${
      type === 'success' ? 'bg-emerald-600 shadow-emerald-900/50' : 'bg-slate-800'
    }`;
    toast.classList.remove('opacity-0', 'pointer-events-none');
    setTimeout(() => {
      toast.classList.add('opacity-0', 'pointer-events-none');
    }, 2200);
  }
});
</script>

<%- include('partials/footer') %>
